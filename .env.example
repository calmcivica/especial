# Example environment variables for Especialidades App
# Copy this file to .env and fill in the values

# Database connection
SERVER=your_sql_server
DATABASE_ESPECIALIDADES=your_especialidades_db
DATABASE_SQL=your_sql_db
USERNAME_ESPECIALIDADES=your_especialidades_username
PASSWORD_ESPECIALIDADES=your_sql_password
USERNAME_SQL=your_sql_username
PASSWORD_SQL=your_sql_password

# OpenAI API
OPENAI_API_KEY=your_openai_key

# Pinecone
PINECONE_API_KEY=your_pinecone_key
PINECONE_ENVIRONMENT=your_pinecone_env
PINECONE_INDEX=your_pinecone_index

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL